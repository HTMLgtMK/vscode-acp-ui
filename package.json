{
    "scripts": {
        "vscode:prepublish": "npm run package",
        "build:webview": "vite build --config webview/acp-ui/vite.config.ts && vite build --config webview/control-panel/vite.config.ts",
        "dev:standalone": "concurrently --names FE,BE --prefix-colors cyan,yellow 'vite --config standalone/vite.config.ts' 'tsx --watch standalone/server.ts'",
        "dev:standalone:demo": "ACP_UI_DEMO=1 concurrently --names FE,BE --prefix-colors cyan,yellow 'vite --config standalone/vite.config.ts' 'tsx --watch standalone/server.ts'",
        "build:fixtures": "tsx scripts/build-showcase-fixtures.ts",
        "sync:standalone-theme": "tsx scripts/sync-standalone-theme.ts",
        "screenshots": "npm run build:fixtures && tsx scripts/capture-readme-screenshots.ts",
        "build": "npm run build:webview && node esbuild.mjs",
        "build:sdk": "npm run build:webview && node esbuild.sdk.mjs && tsc -p tsconfig.sdk.json && node scripts/emit-sdk-package.mjs",
        "watch": "node esbuild.mjs --watch",
        "package": "npm run build:webview && node esbuild.mjs --production",
        "check": "tsc --noEmit && tsc --noEmit -p webview/acp-ui/tsconfig.json && tsc --noEmit -p webview/control-panel/tsconfig.json && tsc --noEmit -p standalone/tsconfig.json",
        "test": "vitest run",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "verify": "concurrently --names Build,Check,Test,Lint 'npm run build' 'npm run check' 'npm run test' 'npm run lint'",
        "publish:vscode": "bash scripts/publish.sh",
        "install:local": "bash scripts/install-local.sh",
        "sync:docs": "bash scripts/sync-docs.sh"
    },
    "name": "ib-acp-ui",
    "displayName": "ACP UI",
    "description": "Agent Client Protocol (ACP) UI integration",
    "publisher": "irishbruse",
    "author": "Ethan Conneely",
    "version": "0.5.0",
    "icon": "icon.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/IrishBruse/vscode-acp-ui.git"
    },
    "engines": {
        "vscode": "^1.125.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {},
    "dependencies": {
        "@agentclientprotocol/sdk": "^1.1.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.2",
        "@types/node": "^26.1.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.0",
        "@types/vscode": "^1.125.0",
        "@types/ws": "^8.18.0",
        "@vitejs/plugin-react": "^6.0.3",
        "@vscode/vsce": "^3.9.2",
        "concurrently": "^10.0.3",
        "esbuild": "^0.28.1",
        "playwright": "^1.55.0",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3",
        "vite": "^8.1.3",
        "vitest": "^4.1.9"
    }
}
