{
    "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**",
            "!webview",
            "!playground/index.html",
            "!playground/mock",
            "!media",
            "!dist",
            "!docs/acp",
            "!docs/cursor-extensions"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always"
        }
    },
    "overrides": [
        {
            "includes": [
                "src/acp/mapping/toolCallDiffLines.ts",
                "src/acp/mapping/sessionUpdateMapping.ts",
                "src/acp/infrastructure/acpAgentProcess.ts"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "noNonNullAssertion": "off"
                    }
                }
            }
        }
    ]
}
